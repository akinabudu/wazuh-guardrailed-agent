# ---------------------------------------------------------------------------
# Copy to .env (setup.sh does this and fills in the __PLACEHOLDER__ secrets).
# Keep .env secret. It is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL (single data backbone) ---
POSTGRES_USER=__POSTGRES_USER__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=__POSTGRES_DB__
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://__POSTGRES_USER__:__POSTGRES_PASSWORD__@127.0.0.1:5432/__POSTGRES_DB__

# --- Language model: Claude on Amazon Bedrock (default) ---
# The prompt, holding the alert and its events, goes to Bedrock in this AWS
# account. The host's IAM role needs bedrock:InvokeModel on the model.
LLM_PROVIDER=bedrock
# Inference-profile IDs (us.anthropic.claude-opus-4-6-v1) go through InvokeModel;
# bare IDs of newer models (anthropic.claude-opus-5-5) go through the Messages-API
# endpoint, if the account is allowed to use them. Opus 4.6 is the evaluated pick
# (evaluation/model-comparison.md).
BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1
# Messages-API models only: requests the model declines (stop_reason "refusal")
# are retried here, e.g. anthropic.claude-opus-4-8; empty disables.
BEDROCK_FALLBACK_MODEL=
# low | medium | high | xhigh | max; empty uses the model default.
BEDROCK_EFFORT=
AWS_REGION=us-east-1

# --- Optional: a model self-hosted on the instance (LLM_PROVIDER=ollama) ---
# setup.sh installs Ollama and pulls OLLAMA_MODEL only when LLM_PROVIDER=ollama.
# phi4-mini is the comparison model of the evaluation.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini
# Fixed sampling so evaluation runs are reproducible.
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
# Seconds to wait for one model call; raise for 7B+ models on CPU.
OLLAMA_TIMEOUT=300
# Set to false for reasoning models (e.g. qwen3:8b); leave empty for phi4-mini.
OLLAMA_THINK=

# --- Wazuh ---
WAZUH_URL=https://127.0.0.1:55000        # manager API
WAZUH_INDEXER_URL=https://127.0.0.1:9200 # indexer (query alerts/events)
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=__WAZUH_API_PASSWORD__
INDEXER_USER=admin
INDEXER_PASSWORD=__INDEXER_PASSWORD__
# Address the manager accepts agent enrolment on (1514/1515). Loopback by
# default; set to the host's private IP only behind a restrictive firewall.
WAZUH_AGENT_BIND=127.0.0.1

# --- App / backend ---
APP_SECRET=__APP_SECRET__
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Telegram (NOTIFY-ONLY; leave blank to disable) ---
# Approvals never happen over Telegram. This only pings an analyst to open
# the dashboard. Keep the alert content thin: a proposal id and a risk level.
# Blank by default: the evaluation lab ran without it, so it is untested there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Guardrail policy ---
# Comma-separated hostnames/asset tags that must NEVER be auto-actioned.
CROWN_JEWEL_ASSETS=dc01,payroll,backup-primary
# Comma-separated CIDRs that block_ip and isolate_host may never target: the
# Wazuh manager, DNS resolvers, gateways. Loopback and link-local (including the
# cloud metadata address) are always protected.
PROTECTED_NETWORKS=
# Max autonomous (auto-approved) actions per hour before the circuit breaker trips.
AUTO_ACTION_RATE_LIMIT=10
